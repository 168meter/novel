    {
      "id": 25,
      "title": "Reading Kafka Send / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 57},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_reading_kafka_send_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "10s",
