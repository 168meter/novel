    {
      "id": 10,
      "title": "Hikari Connection Pressure",
      "description": "Connections are not SQL throughput. Active/max is a pool capacity fraction; pending is waiting requests; timeout rate has its own unit/axis. Acquire average is supporting and N/A without acquisition events. Inspect the selected pool and instance.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"$job\", instance=~\"$instance\"} / hikaricp_connections_max{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{pool}} active / max",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "hikaricp_connections_pending{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{pool}} pending",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance, pool) (rate(hikaricp_connections_timeout_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{pool}} timeouts/s",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "(sum by (instance) (rate(hikaricp_connections_acquire_seconds_sum{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (rate(hikaricp_connections_acquire_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(hikaricp_connections_acquire_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} acquire average",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
