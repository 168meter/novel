{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Application Target / Uptime",
      "description": "Benchmark validity: up=1 means a successful scrape, not all dependencies healthy. Uptime reset marks application restart; N/A marks absent input. Select one instance for evidence screenshots.",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} scrape up",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "process_uptime_seconds{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} uptime",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Uptime (s)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Chapter Throughput by Status",
      "description": "Only GET chapter page requests; requests/s by status and instance. Successful throughput must be read alongside errors and the load-generator report.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, status) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} HTTP {{status}} req/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Successful Chapter Latency — P50 / P95 / P99",
      "description": "Server-side histogram estimates for HTTP 200 chapter GETs, computed per instance. No successful requests means N/A, not 0 ms. Client timeouts and connection failures require load-generator evidence.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(http_server_requests_seconds_bucket{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} P50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(http_server_requests_seconds_bucket{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} P95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(http_server_requests_seconds_bucket{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\", status=\"200\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} P99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Chapter HTTP Status Share",
      "description": "Share of chapter GET requests by HTTP status (including 200, 404, 503 and 500 when observed). Each instance uses its own positive request denominator. Absent status series are not fabricated as zero; 404 and 503 are distinct outcomes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum by (instance, status) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\"}[$__rate_interval])) / on (instance) group_left sum by (instance) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(http_server_requests_seconds_count{job=~\"$job\", instance=~\"$instance\", uri=\"/book/{bookId}/{bookIndexId}.html\", method=\"GET\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} HTTP {{status}} share",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.axisSoftMax",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Chapter Cache Lookup / Hit Ratio",
      "description": "Initial cache lookup per getOrLoad: hit includes a null marker. Retries and later reads are not additional lookup outcomes. Ratio uses hit / all initial lookups including errors; without activity ratio is N/A. This is not the successful chapter response ratio.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, result) (rate(novel_chapter_cache_lookup_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{result}} lookups/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "(sum by (instance) (rate(novel_chapter_cache_lookup_total{job=~\"$job\", instance=~\"$instance\", result=\"hit\"}[$__rate_interval])) / sum by (instance) (rate(novel_chapter_cache_lookup_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))) and on (instance) (sum by (instance) (rate(novel_chapter_cache_lookup_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}} initial hit ratio",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Initial hit ratio"
              },
              {
                "id": "custom.axisSoftMax",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Chapter Content Loader / Write / Front Eviction",
      "description": "Content Loader counts actual loader executions, including failed executions; excludes book/index/navigation queries. Writes include content or null markers. Eviction counts delete operations, not keys removed or TTL expiry. Only front eviction is scraped.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(novel_chapter_cache_load_seconds_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} Content Loader executions/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance, result) (rate(novel_chapter_cache_write_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} write {{result}}/s",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance, result) (rate(novel_chapter_cache_eviction_total{job=~\"$job\", instance=~\"$instance\", source=\"front\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} front eviction {{result}}/s",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Shared Front Executor — Capacity / Rejections",
      "description": "novel.front.executor is shared by front pages, not chapter-exclusive. Active/max and queued/(queued+remaining) are capacity fractions; rejection is tasks/s on a separate axis. Current executor execution/idle timers are not recorded and are intentionally excluded.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "executor_active_threads{job=~\"$job\", instance=~\"$instance\", name=\"novel.front.executor\"} / executor_pool_max_threads{job=~\"$job\", instance=~\"$instance\", name=\"novel.front.executor\"}",
          "legendFormat": "{{instance}} active / max",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "executor_queued_tasks{job=~\"$job\", instance=~\"$instance\", name=\"novel.front.executor\"} / (executor_queued_tasks{job=~\"$job\", instance=~\"$instance\", name=\"novel.front.executor\"} + executor_queue_remaining_tasks{job=~\"$job\", instance=~\"$instance\", name=\"novel.front.executor\"})",
          "legendFormat": "{{instance}} queue occupancy",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_front_executor_rejections_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} rejected tasks/s",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Rejected tasks/s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.axisSoftMax",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.axisSoftMax",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Kafka Application Flow — Messages / Updates / Persisted Seconds",
      "description": "Producer success means send acknowledgement; consumers increment after their transactional writer returns. Messages, distinct-book updates and persisted seconds are different units and are not 1:1. Reading received includes deduplicated events; persisted seconds excludes them. Retry semantics differ: book counts failed delivery callbacks; reading counts attempts after the initial delivery. Book DLT counter marks recovery callback completion, not a separately confirmed broker acknowledgement.",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance, result) (rate(novel_book_visit_kafka_send_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} book producer {{result}} messages/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_book_visit_kafka_consumed_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} book committed messages/s",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance, result) (rate(novel_reading_kafka_producer_send_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} reading producer {{result}} messages/s",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_reading_kafka_consumed_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} reading committed received events/s",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_book_visit_kafka_db_updates_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} aggregated book updates/s",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_reading_kafka_persisted_seconds_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} persisted reading seconds/s",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_reading_kafka_retry_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} reading retries/s",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_reading_kafka_dlt_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} reading DLT records/s",
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_reading_kafka_dlt_publish_failures_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} reading DLT failures/s",
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_book_visit_kafka_retry_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} book failed deliveries/s",
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        },
        {
          "expr": "sum by (instance) (rate(novel_book_visit_kafka_dlt_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} book DLT recovery callbacks/s",
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "",
            "showPoints": "never",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
