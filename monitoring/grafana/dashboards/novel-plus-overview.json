{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Application Target",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"novel-front\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 2,
      "title": "HTTP Requests / s",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[$__rate_interval]))", "legendFormat": "requests/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "title": "HTTP Average / P95 / P99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[$__rate_interval])))", "legendFormat": "P95", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[$__rate_interval])))", "legendFormat": "P99", "refId": "B"},
        {"expr": "sum(rate(http_server_requests_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count[$__rate_interval])), 1e-9)", "legendFormat": "Average", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "HTTP 5xx Ratio",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1e-9)) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.01}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "title": "Chapter Cache Hit Ratio",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_chapter_cache_lookup_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(novel_chapter_cache_lookup_total[5m])), 1e-9)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 0.9}, {"color": "green", "value": 0.98}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6,
      "title": "Cache Lookups / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 9, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_chapter_cache_lookup_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "title": "Cache Writes / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 9, "x": 15, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_chapter_cache_write_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "title": "Cache Lock Outcomes / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_chapter_cache_lock_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "title": "Chapter DB Loads / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_chapter_cache_load_seconds_count[$__rate_interval]))", "legendFormat": "loads/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 10,
      "title": "Chapter DB Load Average",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_chapter_cache_load_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(novel_chapter_cache_load_seconds_count[$__rate_interval])), 1e-9)", "legendFormat": "average", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 11,
      "title": "Kafka Send / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_book_visit_kafka_send_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 12,
      "title": "Kafka Consume and DB Update / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(novel_book_visit_kafka_consumed_total[$__rate_interval]))", "legendFormat": "consumed", "refId": "A"},
        {"expr": "sum(rate(novel_book_visit_kafka_db_updates_total[$__rate_interval]))", "legendFormat": "db updates", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 13,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kafka_consumer_fetch_manager_records_lag{topic=\"novel-book-visit-v1\"})", "legendFormat": "total lag", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 14,
      "title": "Kafka Batch Size",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_book_visit_kafka_batch_size_sum[$__rate_interval])) / clamp_min(sum(rate(novel_book_visit_kafka_batch_size_count[$__rate_interval])), 1e-9)", "legendFormat": "messages/batch", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 15,
      "title": "Aggregated Books / Batch",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_book_visit_kafka_aggregated_books_sum[$__rate_interval])) / clamp_min(sum(rate(novel_book_visit_kafka_aggregated_books_count[$__rate_interval])), 1e-9)", "legendFormat": "books/batch", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 16,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{area=\"heap\"}), 1)", "legendFormat": "heap", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 17,
      "title": "GC Pause / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 36},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(jvm_gc_pause_seconds_sum[$__rate_interval]))", "legendFormat": "pause seconds/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 18,
      "title": "Live Threads",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 36},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(jvm_threads_live_threads)", "legendFormat": "threads", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 19,
      "title": "Hikari Connections",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 36},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(hikaricp_connections_active)", "legendFormat": "active", "refId": "A"},
        {"expr": "sum(hikaricp_connections_idle)", "legendFormat": "idle", "refId": "B"},
        {"expr": "sum(hikaricp_connections_pending)", "legendFormat": "pending", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 20,
      "title": "Hikari Acquire Average",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 43},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(hikaricp_connections_acquire_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(hikaricp_connections_acquire_seconds_count[$__rate_interval])), 1e-9)", "legendFormat": "average", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 21,
      "title": "Front Executor Utilization",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 43},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "executor_active_threads{name=\"novel.front.executor\"}", "legendFormat": "active", "refId": "A"},
        {"expr": "executor_pool_size_threads{name=\"novel.front.executor\"}", "legendFormat": "pool size", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 22,
      "title": "Front Executor Queue / Rejections",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 50},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "executor_queued_tasks{name=\"novel.front.executor\"}", "legendFormat": "queued", "refId": "A"},
        {"expr": "executor_queue_remaining_tasks{name=\"novel.front.executor\"}", "legendFormat": "queue remaining", "refId": "B"},
        {"expr": "sum(rate(novel_front_executor_rejections_total[$__rate_interval]))", "legendFormat": "rejections/s", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 23,
      "title": "Reading Heartbeat Outcomes",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 57},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(novel_reading_heartbeat_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 24,
      "title": "Reading Credited Seconds / s",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 57},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(novel_reading_credited_seconds_total[$__rate_interval]))", "legendFormat": "credited seconds/s", "refId": "A"}],
