<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.java2nb.novel.mapper.FrontUserMapper">

    <resultMap id="AuthUserResult" type="com.java2nb.novel.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="password" property="password"/>
        <result column="password_algorithm" property="passwordAlgorithm"/>
        <result column="token_version" property="tokenVersion"/>
        <result column="email_verified_at" property="emailVerifiedAt"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="AuthColumns">
        id, username, email, password, password_algorithm, token_version, email_verified_at, status
    </sql>

    <select id="selectAuthByEmail" resultMap="AuthUserResult">
        SELECT <include refid="AuthColumns"/> FROM `user` WHERE email = #{normalizedEmail}
    </select>

    <select id="selectAuthByLegacyUsername" resultMap="AuthUserResult">
        SELECT <include refid="AuthColumns"/> FROM `user` WHERE username = #{username}
    </select>

    <select id="selectTokenVersionValue" resultType="java.lang.Long">
        SELECT token_version FROM `user` WHERE id = #{userId}
    </select>

    <update id="upgradeLegacyPassword">
        UPDATE `user` SET password = #{newHash}, password_algorithm = 'ARGON2ID', update_time = #{now}
        WHERE id = #{userId} AND password = #{oldHash} AND password_algorithm = 'MD5'
    </update>


    <update id="addUserBalance" >
        update user set account_balance = account_balance + ${amount}
        where id = #{userId}
    </update>


</mapper>
