MYSQL_DATABASE=novel_plus
# Public placeholders let `compose config --quiet` validate this example.
# Replace them in ignored .env before starting services; they are not secrets.
MYSQL_ROOT_PASSWORD=EXAMPLE_ONLY_CHANGE_MYSQL_PASSWORD
REDIS_PASSWORD=EXAMPLE_ONLY_CHANGE_REDIS_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=EXAMPLE_ONLY_CHANGE_GRAFANA_PASSWORD

# Standard host ports. Override in ignored .env when occupied or covered by
# Windows excluded port ranges. Container ports remain unchanged.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9092
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# Required application secrets: set locally; never commit actual values.
JWT_SECRET=
CACHE_MANAGER_PASSWORD=
NOVEL_AUTH_HMAC_SECRET=
NOVEL_READING_ENGAGEMENT_IP_HMAC_SECRET=
